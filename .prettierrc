{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^(react|react-dom)(.*)$",
    "^next(.*)$",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/types(.*)$",
    "^@/config(.*)$",
    "^@/constants(.*)$",
    "^@/lib(.*)$",
    "^@/hooks(.*)$",
    "^@/stores(.*)$",
    "^@/providers(.*)$",
    "^@/components(.*)$",
    "^@/modules(.*)$",
    "",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "tailwindFunctions": ["cn", "cva"]
}
